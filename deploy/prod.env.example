# Шаблон prod-окружения. Только плейсхолдеры, реальные значения - в .env.prod / .env.tg
# в корне репозитория (оба в .gitignore). Секреты генерировать: openssl rand -hex 32

# ===== RU-сервер -> .env.prod =====
POSTGRES_USER=brand_activities_bot
POSTGRES_PASSWORD=<PWD_HEX>
POSTGRES_DB=brand_activities_bot
# DATABASE_URL compose собирает сам из POSTGRES_* (docker-compose.prod.yml).
INTERNAL_API_AUTH_SECRET=<HMAC_KEY_64_HEX>
ADMIN_SESSION_SECRET=<SESSION_KEY_64_HEX>
COOKIE_SECURE=true
DOMAIN=<example.ru>
PUBLIC_BASE_URL=https://<example.ru>
# jobs_worker скачивает файлы пользователей через api.telegram.org -> токен нужен и на RU.
TELEGRAM_BOT_TOKEN=<FROM_BOTFATHER>
OBJECT_STORAGE_IMPL=local_fs
UGC_LOCAL_PATH=/data/ugc
# Только при OBJECT_STORAGE_IMPL=selectel_s3:
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
TZ=Europe/Moscow
BACKUP_RETENTION_DAYS=14

# ===== 2-й сервер -> .env.tg =====
# TELEGRAM_BOT_TOKEN=<FROM_BOTFATHER>
# INTERNAL_API_URL=https://<example.ru>
# INTERNAL_API_AUTH_SECRET=<SAME_AS_RU_SERVER>
# TZ=Europe/Moscow
