# brand_activities_bot — пример переменных окружения.
# Копируется в .env локально. В репозиторий коммитится ТОЛЬКО этот файл.
# Все значения — фиктивные плейсхолдеры (REPLACE_ME, change-me, пример URL).

# ────────────────────────────────────────────────────────────
# секреты-провайдеров
# ────────────────────────────────────────────────────────────

# Токен Telegram-бота, выдаётся BotFather. Запрос у BotFather — только по явному решению владельца.
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>

# Секрет для верификации вебхука Telegram (заголовок X-Telegram-Bot-Api-Secret-Token).
# Случайная строка ≥ 32 символов. Устанавливается на setWebhook — только по явному решению владельца.
WEBHOOK_SECRET=<WEBHOOK_SECRET>

# Ключ для авторизации внутренних вызовов адаптеров к /v1/* (заголовок X-Internal-Key).
# Случайная строка ≥ 32 символов.
INTERNAL_API_KEY=<INTERNAL_API_KEY>

# ────────────────────────────────────────────────────────────
# база
# ────────────────────────────────────────────────────────────

# Строка подключения к Postgres. В docker-compose хост — имя сервиса `postgres`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/brand_activities_bot

# ────────────────────────────────────────────────────────────
# хранилище
# ────────────────────────────────────────────────────────────

# Корень локального тома для UGC-файлов. Внутри — <year>/<month>/<uuid>.<ext>.
UGC_STORAGE_PATH=/data/ugc

# Макс. размер загружаемого UGC-файла в байтах (5 МБ в архитектуре §8).
UGC_MAX_FILE_BYTES=5242880

# Каталог для статических медиа ядра (листовки, PDF).
MEDIA_STATIC_PATH=/data/media

# Каталог ночных pg_dump-бэкапов (архитектура §14, ретеншн 14 дней).
BACKUPS_PATH=/data/backups

# ────────────────────────────────────────────────────────────
# оплата
# ────────────────────────────────────────────────────────────
# В MVP реальных платежей нет. Выдаются внутренние промокоды и ваучеры.
# Платёжный провайдер подключается только через `app/core/ports/payment.py`
# и только после явного решения владельца. Переменные добавятся сюда вместе с портом.

# ────────────────────────────────────────────────────────────
# бизнес-конфиг
# ────────────────────────────────────────────────────────────

# Среда исполнения: dev | staging | prod. Влияет на polling vs webhook и строгость логов.
APP_ENV=dev

# Таймзона слотов и напоминаний (архитектура §16 — гипотеза Europe/Moscow до подтверждения).
APP_TIMEZONE=Europe/Moscow

# Актуальная версия политики ПДн. Пара (версия, hash текста) записывается в Consent.
PDN_POLICY_VERSION=v1

# TTL регистрации без активности, суток (архитектура §11 — 365).
REGISTRATION_INACTIVITY_TTL_DAYS=365

# TTL хранения отклонённых UGC-файлов, суток (архитектура §16 — 30).
UGC_REJECTED_TTL_DAYS=30

# Публичный URL сервиса (для webhook и ссылок на /media). В dev — пусто.
PUBLIC_BASE_URL=

# Секрет для HMAC-подписи заголовка X-Internal-Auth при вызове /internal/v1/* из tg_worker.
# Случайная строка >= 32 символов. Общий между ядром (app) и tg_worker.
INTERNAL_API_AUTH_SECRET=

# Админка (фаза 1.5): ключ подписи session-cookie (itsdangerous) и Secure-флаг cookie.
# Реальное значение - длинная случайная строка, только в локальном .env; плейсхолдер ниже ключом не считается (503).
ADMIN_SESSION_SECRET=<ADMIN_SESSION_SECRET>
COOKIE_SECURE=false

# UGC local storage (dev-only; prod — Selectel Cloud Storage S3)
UGC_LOCAL_PATH=./data/ugc
UGC_PREVIEW_TTL_SECONDS=

# Фаза 3c (ADR-29): объектное хранилище. local_fs - dev; selectel_s3 - Selectel и MinIO.
OBJECT_STORAGE_IMPL=local_fs
S3_ENDPOINT_URL=<S3_ENDPOINT_URL>
S3_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>
S3_REGION_NAME=<S3_REGION_NAME>
S3_BUCKET_UGC=<S3_BUCKET_UGC>

# Booking (phase 4)
PUBLIC_BASE_URL=<PUBLIC_BASE_URL>
OUTBOX_TEXT_APPOINTMENT_REMINDER=<OUTBOX_TEXT_APPOINTMENT_REMINDER>
OUTBOX_TEXT_APPOINTMENT_AUTO_CANCELLED=<OUTBOX_TEXT_APPOINTMENT_AUTO_CANCELLED>
OUTBOX_TEXT_APPOINTMENT_LEAFLET=<OUTBOX_TEXT_APPOINTMENT_LEAFLET>
APP_ENV=<APP_ENV>

# Бренд D (phase 5)
S3_BUCKET_FRAMES=<S3_BUCKET_FRAMES>
MEDIA_FRAME_TTL_SECONDS=
OUTBOX_TEXT_WHEEL_RESULT=<OUTBOX_TEXT_WHEEL_RESULT>
OUTBOX_TEXT_POLAROID_READY=<OUTBOX_TEXT_POLAROID_READY>
OUTBOX_TEXT_PROMOCODE=<OUTBOX_TEXT_PROMOCODE>
OUTBOX_TEXT_CONFIRMATION_REJECTED=<OUTBOX_TEXT_CONFIRMATION_REJECTED>
